# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables (Production and Preview).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://cqexpcfmiyygkeoeddre.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required to save inquiries and for /admin/inquiries.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inquiry notifications (Resend) ---
# Optional: if unset, inquiries are still saved, just not emailed.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Without a verified domain, Resend's
# onboarding@resend.dev sender only delivers to the Resend account owner's email.
RESEND_FROM_EMAIL=NeuroRefinement <notifications@neurorefinement.com>
# Comma-separated. Defaults to bryan@neurorefinement.com.
INQUIRY_NOTIFY_EMAIL=bryan@neurorefinement.com
# Optional random string used to hash submitter IPs for rate limiting.
INQUIRY_IP_SALT=

# --- Admin (/admin/inquiries) ---
# Comma-separated allowlist. Defaults to bryan@neurorefinement.com,bpthunstrom@gmail.com.
ADMIN_EMAILS=bryan@neurorefinement.com,bpthunstrom@gmail.com

# --- Cal.com booking ---
# Optional overrides; defaults live in src/lib/config.ts.
NEXT_PUBLIC_CAL_USERNAME=neurorefinement
NEXT_PUBLIC_CAL_FREE_CALL_SLUG=free-20-min-call
NEXT_PUBLIC_CAL_NEW_CLIENT_LESSON_SLUG=new-client-lesson
NEXT_PUBLIC_CAL_COACHING_SLUG=coaching-session
# Existing-client booking, shown only on the unlisted /book/client page.
NEXT_PUBLIC_CAL_EXISTING_CLIENT_URL=https://cal.com/neurorefinement/client-lesson
# Only change these for Cal.com EU (https://cal.eu) or a self-hosted instance.
# NEXT_PUBLIC_CAL_ORIGIN=https://cal.com
# NEXT_PUBLIC_CAL_EMBED_SCRIPT=https://app.cal.com/embed/embed.js

# --- Existing integrations ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
CRON_SECRET=
